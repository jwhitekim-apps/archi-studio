# 값은 비워 둔다. 실제 값은 .env에만 적고 커밋하지 않는다.
# 로컬 Supabase 시작 후 터미널에 출력되는 값을 넣는다.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zotero 연결 (archi-studio-zotero-connection)
# 앱 키: zotero.org에 앱을 등록해 받는다(배포 단계). 시험은 가짜 Zotero 서버를 쓴다.
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=
# 새 앱의 공개 주소. OAuth 콜백 주소(APP_BASE_URL + /api/zotero/callback)를 만든다.
APP_BASE_URL=
# 32바이트를 base64로 쓴 값(openssl rand -base64 32). Zotero 키 암호화에 쓴다.
ZOTERO_KEY_ENCRYPTION_SECRET=
# 시험용 주소 교체. 비워 두면 실제 Zotero 주소를 쓴다.
ZOTERO_API_BASE_URL=
ZOTERO_OAUTH_BASE_URL=

# AI 제공자 (archi-studio-ai-provider). 자세한 설명은 docs/dev/ai-provider.md
# 제공자: claude(기본), gemini, local. 용도별 값이 있으면 그 용도에서 우선한다.
AI_PROVIDER=
AI_PROVIDER_TRANSLATION=
AI_PROVIDER_ANALYSIS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# 비워 두면 기본 모델을 쓴다.
CLAUDE_MODEL_FAST=
CLAUDE_MODEL_SMART=
GEMINI_MODEL_FAST=
GEMINI_MODEL_SMART=
# 학교 로컬 모델(OpenAI 호환). 비서와 같은 값: https://…/v1 까지 포함한다.
LOCAL_LLM_BASE_URL=
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=

# 논문 분석 (archi-studio-paper-analysis)
# Semantic Scholar API 키(선택). 없으면 요청마다 1초씩 기다리고 호출 제한(429)에 걸리기 쉽다.
S2_API_KEY=
